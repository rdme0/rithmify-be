# ====================
# Database Configuration
# ====================
DATABASE_URL=jdbc:postgresql://localhost:5432/tierify
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password

# ====================
# JPA/Hibernate Configuration
# ====================
# Options: create, create-drop, update, validate, none
JPA_DDL_AUTO=update
# Options: true, false
JPA_FORMAT_SQL=true

# ====================
# Redis Configuration
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ====================
# OAuth2 Configuration
# ====================
# Format: {baseUrl}/login/oauth2/code/{registrationId}
# Example for local: http://localhost:8080/login/oauth2/code/spotify
OAUTH2_REDIRECT_URI=http://localhost:8080/login/oauth2/code/spotify

# ====================
# Spotify API Configuration
# ====================
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
